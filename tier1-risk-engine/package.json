{
  "name": "blei-e-risk-engine",
  "version": "1.0.0",
  "description": "BLEI-E Multi-Asset Risk Engine - Cross-Institutional Core",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "test": "jest",
    "test:integration": "jest --testMatch='**/*.integration.test.ts'",
    "backtest": "ts-node backtester/backtest-harness.ts",
    "lint": "eslint src/ backtester/ --ext .ts",
    "format": "prettier --write 'src/**/*.ts' 'backtester/**/*.ts'",
    "docker:build": "docker build -f docker/Dockerfile -t blei-e-risk-engine:latest .",
    "docker:run": "docker run -it -p 3000:3000 blei-e-risk-engine:latest"
  },
  "dependencies": {
    "kafkajs": "^2.2.4",
    "pino": "^8.17.0",
    "numeric": "^1.2.6"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/drb-apes/institutional-grade-nil-valuation-reporting-and-exchange.git",
    "directory": "tier1-risk-engine"
  },
  "author": "drb-apes",
  "license": "Apache-2.0"
}
