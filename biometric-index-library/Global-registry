# src/biometrics/core/calculators.py
from typing import Dict, Any
import math


def resting_heart_rate_index(data: Dict[str, Any]) -> float:
    """
    Inputs:
      - rhr: resting heart rate (bpm)
      - age: years
    Output:
      - 0–100 score (higher = better)
    """
    rhr = data["rhr"]
    age = data.get("age", 30)

    # Simple example: normalize against an age-adjusted target
    target = max(48, 60 + (age - 30) * 0.2)
    ratio = target / max(rhr, 1)
    score = max(0.0, min(100.0, ratio * 80.0))
    return score


def hrv_index(data: Dict[str, Any]) -> float:
    """
    Inputs:
      - rmssd: HRV RMSSD (ms)
    """
    rmssd = data["rmssd"]
    score = 20.0 * math.log10(max(rmssd, 1.0))
    return max(0.0, min(100.0, score))


def pwv_index(data: Dict[str, Any]) -> float:
    """
    Inputs:
      - pwv: pulse wave velocity (m/s)
    """
    pwv = data["pwv"]
    # Lower PWV is better; 6 m/s ~ 100, 12 m/s ~ 0
    score = 100.0 * (12.0 - pwv) / 6.0
    return max(0.0, min(100.0, score))


Public API — query & simulate
# src/biometrics/api/query.py
from typing import List
from biometrics.core.registry import REGISTRY
from biometrics.core.models import IndexMeta, Domain


def get_index(code: str) -> IndexMeta:
    return REGISTRY[code]


def list_by_domain(domain_id: int) -> List[IndexMeta]:
    domain = Domain(domain_id)
    return [i for i in REGISTRY.values() if i.domain == domain]


def list_by_cluster(domain_id: int, cluster_name: str) -> List[IndexMeta]:
    domain = Domain(domain_id)
    return [
        i for i in REGISTRY.values()
        if i.domain == domain and i.cluster == cluster_name
    ]


