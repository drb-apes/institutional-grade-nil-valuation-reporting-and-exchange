// ------------------------------------
// SPONSORSHIP LAYER INTELLIGENCE
// ------------------------------------
app.get("/sponsor-intel/:sponsorId", async (req, res) => {
  const { sponsorId } = req.params;

  const row = await singleRowOr404<{
    sponsor_id: number;
    name: string;
    active_deals: number;
    total_spend: number;
    est_roi: number;
  }>(
    res,
    `
    SELECT
      s.id AS sponsor_id,
      s.name,
      COUNT(d.id) AS active_deals,
      COALESCE(SUM(d.spend), 0) AS total_spend,
      COALESCE(AVG(d.est_roi), 0) AS est_roi
    FROM sponsors s
    LEFT JOIN sponsorship_deals d ON d.sponsor_id = s.id AND d.is_active = TRUE
    WHERE s.id = $1
    GROUP BY s.id, s.name
    `,
    [sponsorId],
    "Sponsor not found"
  );

  if (!row) return;

  res.json({
    sponsorId: row.sponsor_id,
    name: row.name,
    activeDeals: Number(row.active_deals),
    totalSpend: Number(row.total_spend),
    estimatedRoi: Number(row.est_roi)
  });
});

